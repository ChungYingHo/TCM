---
// Chrome-less layout for notes rendered inside the daily-plan dialog (iframe,
// /notes/[slug]?embed=1). No NavBar / SyncBoot / back-link — just the note body,
// so the interactive MDX islands hydrate normally without a nested app shell.
import '@/styles/tailwind.css'

interface Props {
  title?: string
}
const { title = '考點筆記' } = Astro.props
---

<!doctype html>
<html lang="zh-Hant" data-theme="tcm">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;700;900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+"
      crossorigin="anonymous"
    />
    <script is:inline>
      if (localStorage.getItem('tcm-reading') === 'dim') document.documentElement.dataset.reading = 'dim'
    </script>
  </head>
  <body class="bg-base-100 text-base-content">
    <main class="mx-auto w-full max-w-3xl px-4 py-5 sm:px-6">
      <slot />
    </main>
  </body>
</html>
