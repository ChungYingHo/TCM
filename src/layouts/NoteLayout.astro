---
import Layout from './Layout.astro'
import NoteHeader from '@/components/notes/NoteHeader.astro'
import NotePager from '@/components/notes/NotePager.astro'

const { frontmatter } = Astro.props
---

<Layout title={`${frontmatter.title} · TCM 題庫`}>
  <NoteHeader title={frontmatter.title}>
    {frontmatter.summary && <p class="page-desc max-w-2xl">{frontmatter.summary}</p>}
  </NoteHeader>

  <article class="prose max-w-none">
    <slot />
  </article>

  <NotePager />
</Layout>
