---
import '@/styles/tailwind.css'
import NavBar from '@/components/common/NavBar.astro'
import SyncBoot from '@/components/common/SyncBoot.svelte'
import AskAiSelection from '@/components/common/AskAiSelection.svelte'
import NoteDialog from '@/components/common/NoteDialog.svelte'

interface Props {
  title?: string
  gated?: boolean
}
const { title = '後中醫考古題', gated = true } = Astro.props
---

<!doctype html>
<html lang="zh-Hant" data-theme="tcm">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f6f7f8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+"
      crossorigin="anonymous"
    />
    <script is:inline>
      // 夜讀模式記憶 — 預設關閉、維持亮色；同步行動瀏覽器外框色
      if (localStorage.getItem('tcm-reading') === 'dim') {
        document.documentElement.dataset.reading = 'dim'
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', '#15181c')
      }
    </script>
  </head>
  <body class="min-h-screen bg-base-200 text-base-content">
    {
      gated ? (
        <>
          <NavBar />
          <SyncBoot client:load />
          <AskAiSelection client:load />
          <NoteDialog client:load />
          <main class="mx-auto w-full max-w-5xl px-4 py-7 sm:px-6 sm:py-10">
            <slot />
          </main>
          <footer class="mx-auto w-full max-w-5xl px-4 pb-[max(2rem,env(safe-area-inset-bottom))] sm:px-6">
            <p class="border-t border-base-300 pt-5 text-center text-xs tracking-[0.18em] text-base-content/35">
              日拱一卒 · 功不唐捐
            </p>
          </footer>
        </>
      ) : (
        <slot />
      )
    }
  </body>
</html>
