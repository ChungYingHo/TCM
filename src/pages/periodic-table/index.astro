---
import Layout from '@/layouts/Layout.astro'
import NoteNav from '@/components/notes/NoteNav.astro'
import NotePager from '@/components/notes/NotePager.astro'
import PeriodicTableTool from '@/components/periodic/PeriodicTableTool.svelte'
import TeacherHighlights from '@/components/element/TeacherHighlights.astro'
import ElementQuizPage from '@/components/element/ElementQuizPage.svelte'

export const prerender = false
---

<Layout title="元素週期表 · TCM 題庫">
  <NoteNav />
  <header class="mb-6 flex flex-col gap-1.5">
    <p class="page-kicker">筆記 · 基礎</p>
    <h1 class="page-title">元素週期表</h1>
    <p class="page-desc max-w-2xl">
      必背速查表、完整互動週期表（電子組態、電負度/半徑/游離能熱圖）。
    </p>
  </header>

  <!-- 必背速查 -->
  <section class="mb-10">
    <header class="mb-4 flex flex-col gap-1.5">
      <p class="page-kicker">速查</p>
      <h2 class="section-heading">必背速查表</h2>
    </header>
    <TeacherHighlights />
  </section>

  <!-- 原子量估算 + 價電子 -->
  <section class="mb-10">
    <header class="mb-4 flex flex-col gap-1.5">
      <p class="page-kicker">速記</p>
      <h2 class="section-heading">原子量估算與價電子</h2>
    </header>
    <div class="prose max-w-none">
      <h3>沒週期表時，用原子序 Z 粗估原子量 AW</h3>
      <p>原子量 ≈ 質子數 ＋ 中子數。中子／質子比隨原子序增大，分三段估（抓量級用）：</p>
      <table>
        <thead><tr><th>原子序 Z</th><th>#n ／ #p</th><th>原子量估算</th></tr></thead>
        <tbody>
          <tr><td>1–20</td><td>≈ 1</td><td><strong>AW ≈ 2Z</strong></td></tr>
          <tr><td>21–50</td><td>≈ 1.3</td><td><strong>AW ≈ 2.3Z</strong></td></tr>
          <tr><td>51–83</td><td>≈ 1.5</td><td><strong>AW ≈ 2.5Z</strong></td></tr>
        </tbody>
      </table>
      <p>例：Ca（Z=20）→ 2×20 ＝ <strong>40</strong>（實際 40.08）；Br（Z=35）→ 2.3×35 ≈ <strong>80</strong>（實際 79.9）。</p>
      <h3>A 族族數 ＝ 最外層價電子數</h3>
      <ul>
        <li>主族（A 族）元素：<strong>族數 ＝ 價電子數</strong>（ⅠA=1、ⅡA=2、ⅢA=3…ⅦA=7、0 族=8；He 例外為 2）。</li>
        <li>價電子數決定化性、鍵結數與最高氧化態（如 ⅥA 最高 +6、ⅦA 最高 +7）。</li>
      </ul>
    </div>
  </section>

  <!-- 自由練習 -->
  <section class="mb-10 print:hidden">
    <header class="mb-4 flex flex-col gap-1.5">
      <p class="page-kicker">自由練習</p>
      <h2 class="section-heading">元素測驗</h2>
      <p class="page-desc max-w-2xl">
        選擇題型和範圍，自由練習。每日計畫會自動安排必背範圍。
      </p>
    </header>
    <ElementQuizPage client:load />
  </section>

  <!-- 互動週期表 -->
  <section class="border-t border-base-200 pt-8">
    <header class="mb-4 flex flex-col gap-1.5 print:hidden">
      <p class="page-kicker">互動工具</p>
      <h2 class="section-heading">完整週期表</h2>
      <p class="page-desc max-w-2xl">
        點開元素看<b class="font-semibold text-base-content/80">電子組態、價電子、氧化態</b>；切換檢視把<b class="font-semibold text-base-content/80">電負度、原子半徑、游離能、電子親和力</b>上色成熱圖。
      </p>
    </header>
    <PeriodicTableTool client:load />
  </section>

  <NotePager />
</Layout>
