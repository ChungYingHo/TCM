---
import Layout from '@/layouts/Layout.astro'
import NoteHeader from '@/components/notes/NoteHeader.astro'
import NotePager from '@/components/notes/NotePager.astro'
import { AMINO_ACIDS, AA_CATEGORY_LABEL, type AACategory } from '@/models/aminoAcids'
import AminoAcidStructure from '@/components/amino/AminoAcidStructure.svelte'
import ExampleQuestion from '@/components/notes/ExampleQuestion.svelte'
import Memorize from '@/components/notes/Memorize.svelte'

export const prerender = false

// 依大綱順序：非極性脂肪族 → 極性不帶電 → 帶負電(酸性) → 帶正電(鹼性) → 芳香族
const CATS: AACategory[] = ['nonpolar', 'polar', 'acidic', 'basic', 'aromatic']
const byCat = CATS.map((c) => ({ c, items: AMINO_ACIDS.filter((a) => a.category === c) }))
---

<Layout title="20 種胺基酸 · TCM 題庫">
  <NoteHeader title="20 種胺基酸">
    <p class="page-desc max-w-2xl">
      每個胺基酸都是<b class="font-semibold text-base-content/80">共通的兩性離子骨架</b>（H₃N⁺–C(–COO⁻)–H）接上不同的<b class="font-semibold text-base-content/80">側鏈 R</b>——要背的就是那個 R。下圖<b class="font-semibold text-base-content/80">黑色為骨架、紅色為側鏈</b>，依側鏈的酸鹼極性分成五類。
    </p>
  </NoteHeader>

  <div class="mb-5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-base-content/55">
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-4 rounded-sm" style="background:var(--color-base-content)"></span>共通骨架</span>
    <span class="inline-flex items-center gap-1.5"><span class="inline-block h-2.5 w-4 rounded-sm" style="background:var(--color-error)"></span>側鏈 R（要背）</span>
    <span>必需胺基酸 9 個：His・Ile・Leu・Lys・Met・Phe・Thr・Trp・Val</span>
  </div>

  <div class="flex flex-col gap-7 aa-root">
    {
      byCat.map((grp) => (
        <section class="aa-cat">
          <h2 class="section-heading mb-3">
            {AA_CATEGORY_LABEL[grp.c]}
            <span class="section-sub">{grp.items.length} 個</span>
          </h2>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
            {grp.items.map((a) => (
              <div class="aa-card flex flex-col items-center justify-between rounded-box border border-base-300 bg-base-100 p-3 shadow-soft">
                <AminoAcidStructure code1={a.code1} size={148} client:visible />
                <div class="mt-1.5 text-center">
                  <div class="font-semibold leading-tight">
                    {a.zh} <span class="font-normal text-base-content/55">{a.en}</span>
                  </div>
                  <div class="text-xs tabular-nums text-base-content/55">
                    {a.code3}・{a.code1}
                    {a.essential && <span class="ml-1 rounded-full bg-warning/15 px-1.5 py-0.5 text-[0.65rem] font-medium text-warning">必需</span>}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <p class="mt-7 text-xs text-base-content/45">
    結構為兩性離子（生理 pH）畫法；側鏈以縮寫結構式呈現，酸性／鹼性側鏈在生理 pH 多帶電（此處畫中性式以利辨識官能基）。分類採 Lehninger 五大類。
  </p>

  <section class="mt-10 border-t border-base-200 pt-8">
    <header class="mb-4 flex flex-col gap-1.5">
      <p class="page-kicker">自測</p>
      <h2 class="section-heading">例題</h2>
    </header>
    <ExampleQuestion n={1} q="下列胺基酸何者側鏈為鹼性（生理 pH 帶正電）？" options={['Asp (D)', 'Glu (E)', 'Lys (K)', 'Ser (S)']} answer="(C) Lys (K)" steps={['鹼性側鏈＝<b>Lys(K)、Arg(R)、His(H)</b>。', 'Asp(D)/Glu(E) 為酸性（帶負電）；Ser(S) 極性不帶電。']} client:visible />
    <ExampleQuestion n={2} q="下列何者不是必需胺基酸？" options={['Leu 白胺酸', 'Lys 離胺酸', 'Ala 丙胺酸', 'Val 纈胺酸']} answer="(C) Ala 丙胺酸" steps={['9 個必需：His／Ile／Leu／Lys／Met／Phe／Thr／Trp／Val。', 'Ala 可由人體自行合成 → <b>非必需</b>。']} client:visible />
    <ExampleQuestion n={3} q="兩個側鏈氧化可形成雙硫鍵（–S–S–）穩定蛋白質結構，靠哪個胺基酸？" options={['Cys 半胱胺酸', 'Met 甲硫胺酸', 'Gly 甘胺酸', 'Pro 脯胺酸']} answer="(A) Cys 半胱胺酸" steps={['Cys 側鏈含 <b>–SH</b>（硫醇），兩個 –SH 氧化 → –S–S– 雙硫鍵。', 'Met 雖含硫但為硫醚（–S–CH₃），不形成雙硫鍵。']} client:visible />
    <ExampleQuestion n={4} q="20 種胺基酸中，唯一沒有掌性中心（非掌性）的是？" options={['Gly 甘胺酸', 'Ala 丙胺酸', 'Ser 絲胺酸', 'Cys 半胱胺酸']} answer="(A) Gly 甘胺酸" steps={['Gly 側鏈為 H，α 碳接兩個 H → 無四個不同取代基 → <b>無掌性</b>。', '其餘胺基酸 α 碳接四個不同基團 → 皆有掌性（天然為 L 型）。']} client:visible />
  </section>

  <Memorize items={[
    "共通骨架：<code>H₃N⁺–C(–COO⁻)–H</code> 接側鏈 R。生理 pH 為兩性離子，<b>要背的只有 R</b>。",
    "五大分類：非極性脂肪族、極性不帶電、酸性（帶負電）、鹼性（帶正電）、芳香族。",
    "酸性側鏈：<b>Asp (D)、Glu (E)</b>，生理 pH 帶負電。",
    "鹼性側鏈：<b>Lys (K)、Arg (R)、His (H)</b>，生理 pH 帶正電。",
    "9 個必需胺基酸：<b>His・Ile・Leu・Lys・Met・Phe・Thr・Trp・Val</b>。",
    "含硫兩個：<ul><li><b>Cys</b> 側鏈 <code>–SH</code>，兩個氧化成雙硫鍵 <code>–S–S–</code></li><li><b>Met</b> 為硫醚 <code>–S–CH₃</code>，<b>不</b>形成雙硫鍵</li></ul>",
    "唯一非掌性：<b>Gly</b>，側鏈是 H，α 碳接兩個 H。其餘天然皆為 L 型。",
  ]} client:visible />

  <NotePager />
</Layout>
