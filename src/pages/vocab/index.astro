---
import Layout from '@/layouts/Layout.astro'
import VocabTable from '@/components/vocab/VocabTable.svelte'
import vocab from '@/data/vocab.json'

export const prerender = false

const topCorrect = vocab.words
  .filter((w) => w.correct >= 2)
  .slice(0, 18)
---

<Layout title="高頻單字表 · 後中醫題庫">
  <h1 class="mb-1 text-2xl font-bold">英文高頻單字表</h1>
  <p class="mb-3 text-sm opacity-70">
    從三校 {vocab.vocab_questions} 題字彙題的選項統計而來。<b>考過次數</b>＝出現在選項的次數；
    <b>當正解</b>＝它就是正確答案的次數——<b>當正解次數高的字最該先背</b>。點單字可看考過它的題目。
  </p>

  <div class="mb-4 rounded-box border border-accent/30 bg-accent/10 p-3.5">
    <div class="mb-2 text-sm font-bold text-accent">🔑 最該優先背（曾 2 次以上當正解）</div>
    <div class="flex flex-wrap gap-1.5">
      {
        topCorrect.map((w) => (
          <a href={`/study?q=${encodeURIComponent(w.word)}`} class="badge badge-lg cursor-pointer lowercase hover:badge-primary">
            {w.word} <span class="ml-1 opacity-60">×{w.correct}</span>
          </a>
        ))
      }
    </div>
  </div>

  <VocabTable words={vocab.words} client:load />
</Layout>
