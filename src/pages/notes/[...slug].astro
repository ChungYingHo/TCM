---
import Layout from '@/layouts/Layout.astro'
import NoteEmbedLayout from '@/layouts/NoteEmbedLayout.astro'
import { getCollection, render } from 'astro:content'
import { SUBJECT_LABEL } from '@/models/question'
import type { Subject } from '@/models/question'
import AudioReader from '@/components/notes/AudioReader.svelte'
import RelatedQuestions from '@/components/notes/RelatedQuestions.svelte'
import NoteNav from '@/components/notes/NoteNav.astro'

export const prerender = false

const { slug } = Astro.params
// ?embed=1 → chrome-less body for the daily-plan dialog iframe (same-origin, gated).
const embed = Astro.url.searchParams.get('embed') === '1'
const notes = await getCollection('notes')
const entry = notes.find((n) => n.id === slug)
// Unknown slug or a draft note -> back to the index (drafts are unpublished).
if (!entry || entry.data.draft) return Astro.redirect('/notes')

const { Content } = await render(entry)
const subject = entry.data.subject as Subject
const isReview = entry.data.kind === 'review'
---

{
  embed ? (
    <NoteEmbedLayout title={entry.data.title}>
      <div class="mb-2 flex flex-wrap items-center gap-2">
        <span class="badge badge-primary">{SUBJECT_LABEL[subject]}</span>
        {isReview && <span class="badge badge-secondary">複習</span>}
        <span class="badge badge-ghost">{entry.data.tag}</span>
      </div>
      <h1 class="font-display text-2xl font-bold">{entry.data.title}</h1>
      {entry.data.audio && <AudioReader text={entry.data.audio} client:load />}
      <article class="prose mt-5 max-w-none">
        <Content />
      </article>
    </NoteEmbedLayout>
  ) : (
    <Layout title={`${entry.data.title} · 考點筆記`}>
      <div class="mx-auto max-w-3xl">
        <a href="/notes" class="btn btn-ghost btn-sm mb-3">
          ← 所有筆記
        </a>

        <div class="mb-2 flex flex-wrap items-center gap-2">
          <span class="badge badge-primary">{SUBJECT_LABEL[subject]}</span>
          {isReview && <span class="badge badge-secondary">複習</span>}
          <span class="badge badge-ghost">{entry.data.tag}</span>
        </div>
        <h1 class="font-display text-2xl font-bold sm:text-3xl">{entry.data.title}</h1>

        {entry.data.audio && <AudioReader text={entry.data.audio} client:load />}

        <article class="prose mt-5">
          <Content />
        </article>

        <hr class="my-8 border-base-300" />
        <h2 class="mb-1 text-lg font-bold">經典考古題</h2>
        <p class="mb-2 text-sm opacity-60">這些是題庫中標到本考點的真實考題；看答案時會帶出與本筆記一致的解題方向。</p>
        <RelatedQuestions tag={entry.data.tag} limit={4} client:visible />

        <NoteNav subject={subject} slug={entry.id} />
      </div>
    </Layout>
  )
}
