---
import Layout from '@/layouts/Layout.astro'
import { getCollection, render } from 'astro:content'
import { SUBJECT_LABEL } from '@/models/question'
import type { Subject } from '@/models/question'
import AudioReader from '@/components/notes/AudioReader.svelte'
import RelatedQuestions from '@/components/notes/RelatedQuestions.svelte'

export const prerender = false

const { slug } = Astro.params
const notes = await getCollection('notes')
const entry = notes.find((n) => n.id === slug)
if (!entry) return Astro.redirect('/notes')

const { Content } = await render(entry)
---

<Layout title={`${entry.data.title} · 考點筆記`}>
  <a href="/notes" class="btn btn-ghost btn-sm mb-3">← 所有筆記</a>

  <div class="mb-2 flex items-center gap-2">
    <span class="badge badge-primary">{SUBJECT_LABEL[entry.data.subject as Subject]}</span>
    <span class="badge badge-ghost">{entry.data.tag}</span>
  </div>
  <h1 class="text-2xl font-bold sm:text-3xl">{entry.data.title}</h1>

  {entry.data.audio && <AudioReader text={entry.data.audio} client:load />}

  <article class="prose prose-sm mt-2 max-w-none sm:prose-base prose-headings:scroll-mt-20">
    <Content />
  </article>

  <hr class="my-6 border-base-300" />
  <RelatedQuestions tag={entry.data.tag} limit={3} client:visible />
</Layout>
