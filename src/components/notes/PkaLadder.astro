---
// pKa 階梯：把常見有機酸全部釘在同一根尺上，一眼看出兩類化合物差幾個數量級。
// 縱軸 pKa 線性由 −10（最上，最強酸）到 50（最下，最弱酸），所以「距離」直接等於數量級差。
// 標籤在密集區（pKa 9 到 20）會互相重疊，先依真實 pKa 畫點，再做一次「往下推開」的
// 避讓，最後用折線把點與被推開的標籤接回去。純靜態 SVG，不 hydrate。
// 顏色分的是「解離的是哪一種鍵」，因為同一種鍵的 pKa 才有可比性。

type Kind = 'inorg' | 'oh' | 'ch' | 'nh' | 'sh'

interface Entry {
  pka: number
  label: string
  eg: string
  kind: Kind
}

const ENTRIES: Entry[] = [
  { pka: -9, label: '氫鹵酸', eg: 'HI −10、HBr −9、HCl −8', kind: 'inorg' },
  { pka: -3, label: '硫酸', eg: 'H₂SO₄ 第一階', kind: 'inorg' },
  { pka: 0.5, label: '三氟乙酸', eg: 'CF₃COOH', kind: 'oh' },
  { pka: 4.8, label: '羧酸', eg: '乙酸 4.8', kind: 'oh' },
  { pka: 6.4, label: '碳酸', eg: 'H₂CO₃ 第一階 6.4', kind: 'oh' },
  { pka: 9.3, label: '銨離子', eg: 'NH₄⁺ 9.3', kind: 'nh' },
  { pka: 9.9, label: '酚', eg: 'C₆H₅OH 9.9', kind: 'oh' },
  { pka: 10.3, label: '硫醇', eg: 'CH₃SH 10.3', kind: 'sh' },
  { pka: 12.9, label: '1,3-二羰基的 α 氫', eg: '丙二酸二乙酯 12.9', kind: 'ch' },
  { pka: 15, label: '環戊二烯', eg: 'C₅H₆ 15 到 16', kind: 'ch' },
  { pka: 15.7, label: '水', eg: 'H₂O 15.7', kind: 'oh' },
  { pka: 16, label: '醇', eg: '乙醇 16、三級丁醇 18', kind: 'oh' },
  { pka: 17, label: '醯胺的 N—H', eg: '乙醯胺 17', kind: 'nh' },
  { pka: 19.3, label: '酮的 α 氫', eg: '丙酮 19.3', kind: 'ch' },
  { pka: 25, label: '末端炔、酯的 α 氫', eg: '乙炔 25、乙酸乙酯 25', kind: 'ch' },
  { pka: 36, label: '胺的 N—H', eg: '氨 36、二異丙基胺 40', kind: 'nh' },
  { pka: 44, label: '烯的 C—H', eg: '乙烯 44', kind: 'ch' },
  { pka: 50, label: '烷的 C—H', eg: '乙烷 50', kind: 'ch' },
]

const TOP = 36
const BOTTOM = 612
const MIN = -10
const MAX = 50
const GAP = 19
const AXIS_X = 54

const yOf = (pka: number) => TOP + ((pka - MIN) / (MAX - MIN)) * (BOTTOM - TOP)

// 由上往下逐一放，撞到前一個就往下推 GAP。
let cursor = -Infinity
const rows = ENTRIES.map((e) => {
  const yDot = yOf(e.pka)
  const yText = Math.max(yDot, cursor + GAP)
  cursor = yText
  return { ...e, yDot, yText }
})

const ticks = [-10, 0, 10, 20, 30, 40, 50]

const dotCls: Record<Kind, string> = {
  inorg: 'fill-error',
  oh: 'fill-primary',
  ch: 'fill-secondary',
  nh: 'fill-accent',
  sh: 'fill-warning',
}
const lineCls: Record<Kind, string> = {
  inorg: 'stroke-error',
  oh: 'stroke-primary',
  ch: 'stroke-secondary',
  nh: 'stroke-accent',
  sh: 'stroke-warning',
}

const legend: { kind: Kind, text: string }[] = [
  { kind: 'inorg', text: '無機強酸' },
  { kind: 'oh', text: 'O—H' },
  { kind: 'sh', text: 'S—H' },
  { kind: 'nh', text: 'N—H' },
  { kind: 'ch', text: 'C—H' },
]
const chipCls: Record<Kind, string> = {
  inorg: 'bg-error',
  oh: 'bg-primary',
  ch: 'bg-secondary',
  nh: 'bg-accent',
  sh: 'bg-warning',
}
---

<figure
  class="not-prose my-5 rounded-box border border-base-300 bg-base-100 p-4 print:break-inside-avoid sm:p-5"
>
  <figcaption class="mb-1 font-display font-bold text-base-content">
    pKa 階梯：常見有機酸由強到弱
  </figcaption>
  <p class="mb-3 text-xs leading-relaxed text-base-content/70">
    刻度是線性的，兩筆之間差幾格就是差幾個數量級。越靠上的酸性越強、共軛鹼越弱，越靠下的酸性越弱、共軛鹼越強。
  </p>

  <svg viewBox="0 0 320 640" class="block w-full" role="img" aria-label="常見有機酸的 pKa 階梯圖">
    <text x="54" y="14" class="fill-base-content/60 text-[10px]">pKa</text>
    <text x="120" y="14" class="fill-error text-[10px] font-bold">↑ 酸性強、共軛鹼弱</text>

    <line
      x1={AXIS_X}
      y1={TOP - 6}
      x2={AXIS_X}
      y2={BOTTOM + 6}
      class="stroke-base-content/40"
      stroke-width="1.5"
    />

    {
      ticks.map((t) => (
        <>
          <line
            x1={AXIS_X - 4}
            y1={yOf(t)}
            x2={AXIS_X}
            y2={yOf(t)}
            class="stroke-base-content/40"
            stroke-width="1.5"
          />
          <text
            x={AXIS_X - 8}
            y={yOf(t) + 3.5}
            text-anchor="end"
            class="fill-base-content/60 text-[10px]"
          >
            {t}
          </text>
        </>
      ))
    }

    {
      rows.map((r) => (
        <>
          <polyline
            points={`${AXIS_X},${r.yDot.toFixed(1)} ${AXIS_X + 5},${r.yDot.toFixed(1)} ${AXIS_X + 10},${r.yText.toFixed(1)} ${AXIS_X + 14},${r.yText.toFixed(1)}`}
            fill="none"
            class={lineCls[r.kind]}
            stroke-width="1"
            stroke-opacity="0.55"
          />
          <circle
            cx={AXIS_X}
            cy={r.yDot.toFixed(1)}
            r="2.6"
            stroke-width="1.2"
            class={`stroke-base-100 ${dotCls[r.kind]}`}
          />
          <text
            x={AXIS_X + 17}
            y={(r.yText + 3.5).toFixed(1)}
            class="fill-base-content text-[11px] font-bold"
          >
            {r.label}
          </text>
          <text
            x="318"
            y={(r.yText + 3.5).toFixed(1)}
            text-anchor="end"
            class="fill-base-content/60 text-[10px]"
          >
            {r.eg}
          </text>
        </>
      ))
    }

    <text x="120" y="634" class="fill-primary text-[10px] font-bold">↓ 酸性弱、共軛鹼強</text>
  </svg>

  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-base-content/70">
    {
      legend.map((l) => (
        <span class="flex items-center gap-1.5">
          <span class={`inline-block h-2.5 w-2.5 rounded-full ${chipCls[l.kind]}`} />
          {l.text}
        </span>
      ))
    }
  </div>
  <p class="mt-2 text-xs leading-relaxed text-base-content/70">
    顏色分的是解離掉的那一根鍵。同一種鍵才適合直接比，跨顏色比較時要先看是哪個原子帶負電。
  </p>
</figure>
