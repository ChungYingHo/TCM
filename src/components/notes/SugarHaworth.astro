---
// D-葡萄糖的 Fischer 開鏈式與兩個異頭物的 Haworth 環式。
// 三張圖擺在一起才看得出「Fischer 右邊的 OH → Haworth 下方」這條換算規則，
// 以及 α 與 β 的唯一差別只在異頭碳 C1 那一個 OH 朝上還是朝下。
// 純靜態、無 hydration：SSR 直出。
// 每個碳只畫 -OH 與 C6 的 -CH2OH，同一個碳另一側的 H 省略不畫。

// Haworth 六員環的頂點（吡喃醣的標準畫法：環氧在右後方，順時針 C1→C5）
const V: Record<string, [number, number]> = {
  C4: [58, 118],
  C5: [108, 84],
  O: [198, 84],
  C1: [248, 118],
  C2: [198, 152],
  C3: [108, 152],
}
const seg = (a: [number, number], b: [number, number]) => ({ x1: a[0], y1: a[1], x2: b[0], y2: b[1] })
const back = [seg(V.C4, V.C5), seg(V.C5, V.O), seg(V.O, V.C1)]
const front = [seg(V.C1, V.C2), seg(V.C2, V.C3), seg(V.C3, V.C4)]

// 環上碳的編號位置
const RING_NUM: { x: number, y: number, n: string }[] = [
  { x: 214, y: 166, n: '2' },
  { x: 86, y: 166, n: '3' },
  { x: 36, y: 128, n: '4' },
  { x: 88, y: 78, n: '5' },
]

// 兩個異頭物只差 C1 的 -OH 朝上（β，與 C6 同側）或朝下（α，與 C6 異側）
const ANOMERS = [
  {
    name: 'α-D-吡喃葡萄糖',
    sub: 'α-D-glucopyranose',
    c1Up: false,
    note: 'C1 的 –OH 朝下，與 C6 的 –CH₂OH 異側',
  },
  {
    name: 'β-D-吡喃葡萄糖',
    sub: 'β-D-glucopyranose',
    c1Up: true,
    note: 'C1 的 –OH 朝上，與 C6 的 –CH₂OH 同側',
  },
]

// 開鏈 Fischer 投影式的四個掌性中心：-OH 在左或在右
const FISCHER = [
  { y: 76, n: '2', left: 'H', right: 'OH' },
  { y: 108, n: '3', left: 'HO', right: 'H' },
  { y: 140, n: '4', left: 'H', right: 'OH' },
  { y: 172, n: '5', left: 'H', right: 'OH' },
]
---

<figure
  class="not-prose my-5 rounded-box border border-base-300 bg-base-100 p-4 print:break-inside-avoid sm:p-5"
>
  <figcaption class="mb-4 font-display font-bold text-base-content">
    D-葡萄糖：開鏈式與兩個異頭物
  </figcaption>

  <div class="grid gap-4 sm:grid-cols-[minmax(0,13rem)_minmax(0,1fr)]">
    <!-- 開鏈的 Fischer 投影式 -->
    <div class="rounded-box border border-base-300 bg-base-200/40 p-3">
      <p class="mb-1 text-sm font-bold text-secondary">開鏈式 Fischer 投影</p>
      <svg
        viewBox="0 0 200 250"
        class="mx-auto block w-full max-w-[11rem]"
        role="img"
        aria-label="D-葡萄糖開鏈式的費雪投影，C2、C4、C5 的羥基在右，C3 的羥基在左"
      >
        <line x1="100" y1="44" x2="100" y2="204" class="stroke-base-content" stroke-width="2"></line>
        <text x="100" y="32" text-anchor="middle" class="fill-base-content text-[15px] font-bold"
          >CHO</text
        >
        <text x="20" y="32" class="fill-base-content text-[11px]" opacity="0.55">1</text>
        {
          FISCHER.map((r) => (
            <>
              <line
                x1="66"
                y1={r.y}
                x2="134"
                y2={r.y}
                class="stroke-base-content"
                stroke-width="2"
              />
              <text x="60" y={r.y + 5} text-anchor="end" class="fill-base-content text-[14px]">
                {r.left}
              </text>
              <text x="140" y={r.y + 5} class="fill-base-content text-[14px]">
                {r.right}
              </text>
              <text x="20" y={r.y + 4} class="fill-base-content text-[11px]" opacity="0.55">
                {r.n}
              </text>
            </>
          ))
        }
        <text x="100" y="224" text-anchor="middle" class="fill-base-content text-[15px] font-bold"
          >CH₂OH</text
        >
        <text x="20" y="224" class="fill-base-content text-[11px]" opacity="0.55">6</text>
        <line
          x1="168"
          y1="172"
          x2="180"
          y2="172"
          class="stroke-secondary"
          stroke-width="1.5"
          stroke-dasharray="3 3"></line>
        <circle cx="186" cy="172" r="4" class="fill-secondary"></circle>
      </svg>
      <p class="mt-1 text-xs leading-relaxed text-base-content/70">
        羰基畫在最上面。離羰基最遠的掌性中心是 C5（標點處），它的 –OH 在右邊，所以是 D 型。
      </p>
    </div>

    <!-- 兩個異頭物的 Haworth 式 -->
    <div class="grid gap-4 sm:grid-cols-2">
      {
        ANOMERS.map((a) => (
          <div class="rounded-box border border-base-300 bg-base-200/40 p-3">
            <p class="mb-0.5 text-sm font-bold text-primary">{a.name}</p>
            <p class="mb-1 text-xs text-base-content/55">{a.sub}</p>
            <svg
              viewBox="0 0 300 230"
              class="mx-auto block w-full max-w-[17rem]"
              role="img"
              aria-label={`${a.name}的 Haworth 投影`}
            >
              {back.map((l) => (
                <line {...l} class="stroke-base-content" stroke-width="2" />
              ))}
              {front.map((l) => (
                <line {...l} class="stroke-base-content" stroke-width="4.5" />
              ))}

              <circle cx={V.O[0]} cy={V.O[1]} r="11" class="fill-base-100" />
              <text
                x={V.O[0]}
                y={V.O[1] + 6}
                text-anchor="middle"
                class="fill-base-content text-[16px] font-bold"
              >
                O
              </text>

              <circle cx={V.C1[0]} cy={V.C1[1]} r="10" class="fill-primary" fill-opacity="0.2" />
              <text x="266" y="124" class="fill-primary text-[12px] font-bold">
                1
              </text>
              {RING_NUM.map((r) => (
                <text x={r.x} y={r.y} class="fill-base-content text-[12px]" opacity="0.55">
                  {r.n}
                </text>
              ))}

              <line
                x1={V.C5[0]}
                y1={V.C5[1]}
                x2={V.C5[0]}
                y2="58"
                class="stroke-base-content"
                stroke-width="2"
              />
              <text
                x={V.C5[0]}
                y="50"
                text-anchor="middle"
                class="fill-base-content text-[14px] font-semibold"
              >
                CH₂OH
              </text>

              <line
                x1={V.C4[0]}
                y1={V.C4[1]}
                x2={V.C4[0]}
                y2="148"
                class="stroke-base-content"
                stroke-width="2"
              />
              <text x={V.C4[0]} y="164" text-anchor="middle" class="fill-base-content text-[14px]">
                OH
              </text>

              <line
                x1={V.C3[0]}
                y1={V.C3[1]}
                x2={V.C3[0]}
                y2="122"
                class="stroke-base-content"
                stroke-width="2"
              />
              <text x={V.C3[0]} y="114" text-anchor="middle" class="fill-base-content text-[14px]">
                OH
              </text>

              <line
                x1={V.C2[0]}
                y1={V.C2[1]}
                x2={V.C2[0]}
                y2="182"
                class="stroke-base-content"
                stroke-width="2"
              />
              <text x={V.C2[0]} y="198" text-anchor="middle" class="fill-base-content text-[14px]">
                OH
              </text>

              <line
                x1={V.C1[0]}
                y1={V.C1[1]}
                x2={V.C1[0]}
                y2={a.c1Up ? 90 : 148}
                class="stroke-primary"
                stroke-width="2.5"
              />
              <text
                x={V.C1[0]}
                y={a.c1Up ? 82 : 164}
                text-anchor="middle"
                class="fill-primary text-[14px] font-bold"
              >
                OH
              </text>
            </svg>
            <p class="mt-1 text-xs leading-relaxed text-base-content/70">{a.note}</p>
          </div>
        ))
      }
    </div>
  </div>

  <p class="mt-3 text-xs leading-relaxed text-base-content/65">
    換算規則：Fischer 投影式裡在右邊的 –OH，Haworth 裡畫在環的下方，在左邊的畫在上方（C5 的 –OH 拿去關環，不出現在環外，D
    型醣的 C6 –CH₂OH 一律朝上）。粗線是環的前緣。圖中只畫 –OH 與 C6 的 –CH₂OH，接在同一個碳另一側的 H 省略。
  </p>
</figure>
