---
// 三組有機共振式，每一式都把彎箭頭畫出來：箭尾＝電子從哪來，箭頭＝電子往哪去。
// 純靜態 SVG，不 hydrate，SSR 直出。彎箭頭用 arc() 由端點算控制點，避免手刻 path 算錯弧度。

// 由兩端點畫一段弧線：bulge 為正往法線方向鼓、為負往反方向鼓。
function arc(x1: number, y1: number, x2: number, y2: number, bulge: number) {
  const mx = (x1 + x2) / 2
  const my = (y1 + y2) / 2
  const dx = x2 - x1
  const dy = y2 - y1
  const len = Math.hypot(dx, dy) || 1
  const cx = mx + (-dy / len) * bulge
  const cy = my + (dx / len) * bulge
  return `M ${x1} ${y1} Q ${cx.toFixed(1)} ${cy.toFixed(1)} ${x2} ${y2}`
}

const panels = [
  {
    id: 'allyl',
    title: '烯丙基陽離子',
    caption:
      '正電荷與 π 鍵一起攤在三個碳上。兩式完全等價，所以兩端的 CH₂ 各帶一半正電、兩條 C—C 鍵等長。',
  },
  {
    id: 'enolate',
    title: '烯醇負離子',
    caption:
      '羰基旁邊的碳被拔掉一個 H 之後，負電荷可以跑到氧上。氧的電負度較大，右式貢獻較大。',
  },
  {
    id: 'amide',
    title: '醯胺',
    caption:
      'N 的孤對電子推向羰基，C—N 因此帶部分雙鍵性質而不能旋轉，N 也不再隨時能去接質子。',
  },
]
