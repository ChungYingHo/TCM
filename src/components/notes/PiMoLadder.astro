---
// 共軛系統的 π 分子軌域能階圖（直鏈與環狀各一套資料）。
// 純靜態、無 hydration：SSR 直出，列印也完整。
//
// 一列＝一個能階，同一列上有兩個方框就代表那一層是簡併（能量相同的兩條軌域）。
// 苯與環戊二烯基的重點正是「簡併」，所以用同列並排來表示，而不是畫成兩列。
type Level = {
  label: string
  nodes: number // 節面數（垂直於分子平面、把 π 系統切開的面）
  bonding: boolean
  electrons: number[] // 每一條軌域上的電子數，長度＝該層的簡併度
  /** 直鏈系統各碳上的相位（+1／−1）。考題會給軌域圖問哪張是 HOMO／LUMO，
   *  相鄰兩個變號的地方就是一個節面。環狀系統的簡併軌域相位不唯一，故不給。 */
  phases?: (1 | -1)[]
}

interface Props {
  system: 'butadiene' | 'benzene' | 'cyclopentadienyl'
}

type SystemData = {
  title: string
  note: string
  levels: Level[]
}

const SYSTEMS: Record<Props['system'], SystemData> = {
  // 由高能量到低能量
  butadiene: {
    title: '1,3-丁二烯的 π 分子軌域',
    note: '4 個並排的 p 軌域組成 4 個 π 軌域，低能的 2 個是成鍵軌域、高能的 2 個是反鍵軌域。4 個 π 電子剛好填滿兩個成鍵軌域。右邊四個圓是四個碳上的相位，相鄰兩個變號的地方就是一個節面。',
    levels: [
      { label: 'ψ₄', nodes: 3, bonding: false, electrons: [0], phases: [1, -1, 1, -1] },
      { label: 'ψ₃', nodes: 2, bonding: false, electrons: [0], phases: [1, -1, -1, 1] },
      { label: 'ψ₂', nodes: 1, bonding: true, electrons: [2], phases: [1, 1, -1, -1] },
      { label: 'ψ₁', nodes: 0, bonding: true, electrons: [2], phases: [1, 1, 1, 1] },
    ],
  },
  benzene: {
    title: '苯的 π 分子軌域',
    note: '6 個 p 軌域組成 6 個 π 軌域，3 個成鍵、3 個反鍵，中間兩層各是一對簡併軌域。6 個 π 電子填滿全部成鍵軌域，所以 HOMO 與 LUMO 都是簡併的一對。',
    levels: [
      { label: 'ψ₆', nodes: 3, bonding: false, electrons: [0] },
      { label: 'ψ₄　ψ₅', nodes: 2, bonding: false, electrons: [0, 0] },
      { label: 'ψ₂　ψ₃', nodes: 1, bonding: true, electrons: [2, 2] },
      { label: 'ψ₁', nodes: 0, bonding: true, electrons: [2] },
    ],
  },
  cyclopentadienyl: {
    title: '環戊二烯基陽離子的 π 分子軌域',
    note: '5 個 p 軌域組成 5 個 π 軌域，3 個成鍵、2 個反鍵。陽離子只有 4 個 π 電子，最後兩個依罕德定則各佔一條簡併軌域，留下兩個未成對電子。',
    levels: [
      { label: 'ψ₄　ψ₅', nodes: 2, bonding: false, electrons: [0, 0] },
      { label: 'ψ₂　ψ₃', nodes: 1, bonding: true, electrons: [1, 1] },
      { label: 'ψ₁', nodes: 0, bonding: true, electrons: [2] },
    ],
  },
}

const { system } = Astro.props
const data = SYSTEMS[system]

const total = data.levels.reduce((n, lv) => n + lv.electrons.reduce((a, b) => a + b, 0), 0)
// levels 由高能到低能排列，所以「第一個有電子的」就是 HOMO、
// 反轉後「第一個完全沒電子的」就是 LUMO。
const homo = data.levels.find((lv) => lv.electrons.some((e) => e > 0))?.label ?? ''
const lumo =
  [...data.levels].reverse().find((lv) => lv.electrons.every((e) => e === 0))?.label ?? ''

/** 一條軌域上的電子畫成箭頭：2 個成對、1 個單獨、0 個留空。 */
function arrows(e: number): string {
  if (e >= 2) return '↑↓'
  return e === 1 ? '↑' : ''
}
---

<div
  class="not-prose my-6 rounded-box border border-base-300 bg-base-100 p-4 sm:p-5 print:break-inside-avoid"
>
  <div class="mb-3 flex items-center gap-2">
    <span aria-hidden="true">〰️</span>
    <span class="font-display font-bold">{data.title}</span>
  </div>

  <div class="rounded-lg bg-gradient-to-b from-error/[0.06] to-primary/[0.06] p-3 sm:p-4">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-x-2 text-[0.65rem] text-base-content/45">
      <span>能量高 ↑（反鍵）</span>
      <span>π 電子共 {total} 個</span>
    </div>

    <div class="flex flex-col gap-1.5">
      {
        data.levels.map((lv) => (
          <div class="grid grid-cols-[3.6rem_1fr_auto] items-center gap-2 sm:grid-cols-[4.6rem_1fr_auto]">
            <span
              class={`text-right text-xs font-bold ${lv.bonding ? 'text-primary' : 'text-error'}`}
            >
              {lv.label}
            </span>

            <div class="flex items-center gap-2">
              {lv.electrons.map((e, i) => (
                <span
                  class={`inline-flex h-7 min-w-[2.6rem] items-center justify-center rounded border text-sm leading-none ${lv.bonding ? 'border-primary/40 bg-primary/5 text-primary' : 'border-error/40 bg-error/5 text-error'}`}
                  data-orb={i}
                >
                  {arrows(e) || <span class="text-base-content/20">·</span>}
                </span>
              ))}
              {lv.phases && (
                <span class="flex items-center gap-0.5" aria-label={`相位 ${lv.phases.join(' ')}`}>
                  {lv.phases.map((ph, i) => (
                    <span
                      class={`inline-block h-3 w-3 rounded-full ring-1 ${ph === 1 ? 'bg-primary/40 ring-primary/70' : 'bg-secondary/40 ring-secondary/70'}`}
                      data-atom={i}
                    />
                  ))}
                </span>
              )}
              <span class="text-[0.65rem] text-base-content/45">節面 {lv.nodes}</span>
            </div>

            <span class="w-12 text-[0.65rem] font-bold">
              {lv.label === homo && <span class="text-primary">HOMO</span>}
              {lv.label === lumo && <span class="text-secondary">LUMO</span>}
            </span>
          </div>
        ))
      }
    </div>

    <div class="mt-1 text-[0.65rem] text-base-content/45">能量低 ↓（成鍵）　示意圖，非真實能量比例</div>
  </div>

  <p class="mt-3 text-xs leading-relaxed text-base-content/75">{data.note}</p>
</div>
