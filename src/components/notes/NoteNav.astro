---
// 上一篇／下一篇：沿 taxonomy 的「學習路徑」順序（同一科內），讓讀完一篇可直接接著讀。
import { getCollection } from 'astro:content'
import { orderedTags, tagSlug } from '@/models/taxonomy'
import type { Subject } from '@/models/question'

interface Props {
  subject: Subject
  slug: string
}
const { subject, slug } = Astro.props

const notes = (await getCollection('notes')).filter((n) => !n.data.draft)
const titleBySlug = new Map(notes.map((n) => [n.id, n.data.title]))

// 同科、依教學先後排好、且已發佈的筆記序列
const seq = orderedTags(subject)
  .map((tag) => tagSlug(tag))
  .filter((s): s is string => !!s && titleBySlug.has(s))
  .map((s) => ({ slug: s, title: titleBySlug.get(s)! }))

const i = seq.findIndex((n) => n.slug === slug)
const prev = i > 0 ? seq[i - 1] : null
const next = i >= 0 && i < seq.length - 1 ? seq[i + 1] : null
---

{
  (prev || next) && (
    <nav class="mt-12 grid gap-3 sm:grid-cols-2" aria-label="筆記導覽">
      {prev ? (
        <a href={`/notes/${prev.slug}`} class="card card-hover bg-base-100">
          <div class="card-body gap-1 p-4">
            <span class="text-xs font-semibold text-base-content/45">← 上一篇</span>
            <span class="font-display font-bold leading-snug">{prev.title}</span>
          </div>
        </a>
      ) : (
        <span class="hidden sm:block" />
      )}
      {next && (
        <a href={`/notes/${next.slug}`} class="card card-hover bg-base-100 sm:text-right">
          <div class="card-body gap-1 p-4">
            <span class="text-xs font-semibold text-primary">下一篇 →</span>
            <span class="font-display font-bold leading-snug">{next.title}</span>
          </div>
        </a>
      )}
    </nav>
  )
}
