---
// 篇末上一篇/下一篇卡片。與 NoteHeader 共用 siblingNotes，呼叫端 <NotePager /> 即可。
import { siblingNotes } from '@/models/notes'

const path = Astro.url.pathname.replace(/\/+$/, '') || '/'
const { prev, next } = siblingNotes(path)
---

{(prev || next) && (
  <nav class="mt-10 grid grid-cols-2 gap-3 print:hidden" aria-label="上一篇下一篇">
    {prev ? (
      <a href={prev.href} class="panel-hover group flex flex-col gap-1 rounded-box border border-base-300 bg-base-100 p-4 text-left transition-colors hover:border-primary/25">
        <span class="flex items-center gap-1 text-xs font-medium text-base-content/45">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3"><polyline points="15 18 9 12 15 6"></polyline></svg>
          上一篇
        </span>
        <span class="font-display text-sm font-bold leading-snug transition-colors group-hover:text-primary">{prev.title}</span>
      </a>
    ) : <span></span>}
    {next ? (
      <a href={next.href} class="panel-hover group flex flex-col items-end gap-1 rounded-box border border-base-300 bg-base-100 p-4 text-right transition-colors hover:border-primary/25">
        <span class="flex items-center gap-1 text-xs font-medium text-base-content/45">
          下一篇
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </span>
        <span class="font-display text-sm font-bold leading-snug transition-colors group-hover:text-primary">{next.title}</span>
      </a>
    ) : <span></span>}
  </nav>
)}
