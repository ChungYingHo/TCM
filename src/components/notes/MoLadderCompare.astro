---
// 第二週期同核雙原子的兩套分子軌域能階順序，並排對照。
// 純靜態、無 hydration：SSR 直出，列印也完整（資訊不藏在互動後面）。
//
// 兩欄的列數與列高刻意一致，唯一的差別就在中間兩層 σ2p／π2p 對調。那兩列標成
// 強調色，讀者一眼就看得出「換的只有這兩層」，其餘四層完全相同。
interface Level {
  label: string
  orbs: 1 | 2 // 簡併軌域條數：π 是兩條、σ 是一條
  bonding: boolean
  swap?: boolean // 兩套順序中位置互換的那兩層
}

// 由高能量到低能量（畫面由上往下）
const PI_LOWER: Level[] = [
  { label: 'σ*2p', orbs: 1, bonding: false },
  { label: 'π*2p', orbs: 2, bonding: false },
  { label: 'σ2p', orbs: 1, bonding: true, swap: true },
  { label: 'π2p', orbs: 2, bonding: true, swap: true },
  { label: 'σ*2s', orbs: 1, bonding: false },
  { label: 'σ2s', orbs: 1, bonding: true },
]

const SIGMA_LOWER: Level[] = [
  { label: 'σ*2p', orbs: 1, bonding: false },
  { label: 'π*2p', orbs: 2, bonding: false },
  { label: 'π2p', orbs: 2, bonding: true, swap: true },
  { label: 'σ2p', orbs: 1, bonding: true, swap: true },
  { label: 'σ*2s', orbs: 1, bonding: false },
  { label: 'σ2s', orbs: 1, bonding: true },
]

const COLUMNS = [
  {
    levels: PI_LOWER,
    head: 'Li₂　Be₂　B₂　C₂　N₂',
    sub: '價電子總數 ≤ 10',
    tail: 'π2p 在 σ2p 之下',
  },
  {
    levels: SIGMA_LOWER,
    head: 'O₂　F₂　Ne₂',
    sub: '價電子總數 ≥ 11',
    tail: 'σ2p 在 π2p 之下',
  },
]
---

<div
  class="not-prose my-6 rounded-box border border-base-300 bg-base-100 p-4 sm:p-5 print:break-inside-avoid"
>
  <div class="mb-3 flex items-center gap-2">
    <span aria-hidden="true">🪜</span>
    <span class="font-display font-bold">第二週期同核雙原子的兩套能階順序</span>
  </div>

  <div class="mb-2 flex items-center justify-between text-[0.65rem] text-base-content/45">
    <span>能量高 ↑</span>
    <span
      ><b class="text-primary">藍＝成鍵</b>　<b class="text-error">紅＝反鍵</b></span
    >
  </div>

  <div class="grid grid-cols-2 gap-2 sm:gap-4">
    {
      COLUMNS.map((col) => (
        <div class="rounded-lg bg-base-200/45 p-2 sm:p-3">
          <div class="mb-2 text-center">
            <div class="text-[0.8125rem] font-bold leading-tight">{col.head}</div>
            <div class="text-[0.65rem] text-base-content/55">{col.sub}</div>
          </div>

          <div class="flex flex-col gap-1">
            {col.levels.map((lv) => (
              <div
                class={`flex items-center gap-1.5 rounded px-1 py-[3px] ${lv.swap ? 'bg-warning/25 ring-1 ring-warning/40' : ''}`}
              >
                <span
                  class={`w-9 shrink-0 text-right text-[0.65rem] font-bold sm:w-11 sm:text-xs ${lv.bonding ? 'text-primary' : 'text-error'}`}
                >
                  {lv.label}
                </span>
                <span class="flex gap-1">
                  {Array.from({ length: lv.orbs }, (_, i) => (
                    <span
                      class={`block h-[3px] w-5 rounded-full sm:w-7 ${lv.bonding ? 'bg-primary' : 'bg-error'}`}
                      data-orb={i}
                    />
                  ))}
                </span>
              </div>
            ))}
          </div>

          <div class="mt-2 text-center text-[0.65rem] font-bold text-warning">{col.tail}</div>
        </div>
      ))
    }
  </div>

  <div class="mt-1 text-[0.65rem] text-base-content/45">能量低 ↓　示意圖，非真實能量比例</div>

  <p class="mt-3 text-xs leading-relaxed text-base-content/75">
    差別只在<b class="text-warning">黃底那兩層</b>。造成對調的是 <b>s–p 混成</b>：同一個原子的 2s 與
    2p<sub>z</sub> 都是繞鍵軸對稱的 σ 形狀，能量接近時會互相排斥，把 σ2p 往上推過 π2p。2s 與 2p
    的能量差隨核電荷增大而變大，到了 O 之後混成已經很弱，σ2p 就落回 π2p 之下。
  </p>
</div>
