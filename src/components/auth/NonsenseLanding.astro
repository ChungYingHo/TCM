---
import Gate from '@/components/auth/Gate.svelte'
---

<div class="landing">
  <div class="relative z-10 flex min-h-screen flex-col items-center justify-center gap-9 px-6 py-16 text-center">
    <div class="flex flex-col items-center gap-6">
      <img
        src="/TCM.png"
        alt="後中醫題庫"
        width="76"
        height="76"
        class="h-[4.5rem] w-[4.5rem] rounded-2xl shadow-soft ring-1 ring-base-content/5"
      />
      <div class="space-y-3.5">
        <p class="text-[0.7rem] font-semibold uppercase tracking-[0.4em] text-primary/75">a quiet little machine</p>
        <h1 class="font-display text-5xl font-extrabold tracking-tight text-base-content sm:text-6xl">
          子曰：未知。
        </h1>
        <p class="mx-auto max-w-md text-balance text-sm leading-loose text-base-content/55 sm:text-[0.95rem]">
          一道算式的價值惟在於答案本身——至於求解的過程，無論優雅或暴烈，莊嚴或諧謔——最終皆無意義
        </p>
      </div>
    </div>

    <Gate client:load />

    <p class="text-[0.7rem] tracking-[0.22em] text-base-content/30">日拱一卒 · 功不唐捐</p>
  </div>
</div>

<style>
  /* 從賽伯龐克霓虹改為清爽書房光：冷白底＋極淡黛綠/森綠暈，沉靜、有呼吸感 */
  .landing {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(58rem 32rem at 50% -10rem,
        color-mix(in oklab, var(--color-primary) 11%, transparent), transparent 70%),
      radial-gradient(46rem 30rem at 8% 112%,
        color-mix(in oklab, var(--color-secondary) 9%, transparent), transparent 72%),
      radial-gradient(40rem 26rem at 92% 106%,
        color-mix(in oklab, var(--color-accent) 6%, transparent), transparent 72%),
      var(--color-base-200);
  }
</style>
