---
import { isNavActive } from '@/utils/navActive'

const path = Astro.url.pathname

type NavItem = { href: string; label: string }

const nav: NavItem[] = [
  { href: '/home', label: '練習' },
  { href: '/study', label: '題庫' },
  { href: '/vocab', label: '字庫' },
  { href: '/notes', label: '筆記' },
  { href: '/analytics', label: '分析' },
]

const pill = (active: boolean) =>
  `shrink-0 rounded-full px-3.5 py-1.5 text-sm transition-colors ${
    active
      ? 'bg-primary/12 font-semibold text-primary'
      : 'font-medium text-base-content/65 hover:bg-base-content/5 hover:text-base-content'
  }`
---

<header class="z-30 border-b border-base-300/70 bg-base-100/75 pt-[env(safe-area-inset-top)] backdrop-blur-xl lg:sticky lg:top-0 print:hidden">
  <nav class="mx-auto flex w-full max-w-5xl items-center gap-1 px-3 py-3 sm:px-5">
    <a href="/home" class="mr-auto flex shrink-0 items-center gap-2 font-display text-lg font-bold tracking-tight lg:mr-3">
      <img src="/TCM.png" alt="TCM 題庫" width="28" height="28" class="h-7 w-7 shrink-0 rounded-xl object-cover" />
      TCM<span class="text-primary">題庫</span>
    </a>

    <!-- 桌機：橫排連結（lg 以下隱藏，由 BottomNav 接手） -->
    <div class="hidden items-center gap-0.5 lg:flex">
      {nav.map((item) => {
        const active = isNavActive(path, item.href)
        return (
          <a href={item.href} class={pill(active)} aria-current={active ? 'page' : undefined}>
            {item.label}
          </a>
        )
      })}
    </div>

    <button id="reading-toggle" class="grid h-11 w-11 shrink-0 place-items-center rounded-full text-base-content/60 transition-colors hover:bg-base-content/5 hover:text-base-content lg:h-9 lg:w-9" aria-label="切換夜讀(護眼)模式" title="夜讀(護眼)模式">
      <svg data-icon="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-[1.05rem] w-[1.05rem]" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
      </svg>
      <svg data-icon="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="hidden h-[1.05rem] w-[1.05rem]" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
      </svg>
    </button>
  </nav>
</header>

<script is:inline>
  const readingToggle = document.getElementById('reading-toggle')
  const syncReadingIcon = () => {
    const dim = document.documentElement.dataset.reading === 'dim'
    readingToggle?.querySelector('[data-icon="moon"]')?.classList.toggle('hidden', dim)
    readingToggle?.querySelector('[data-icon="sun"]')?.classList.toggle('hidden', !dim)
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', dim ? '#15181c' : '#f6f7f8')
  }
  syncReadingIcon()
  readingToggle?.addEventListener('click', () => {
    const el = document.documentElement
    if (el.dataset.reading === 'dim') {
      delete el.dataset.reading
      localStorage.removeItem('tcm-reading')
    } else {
      el.dataset.reading = 'dim'
      localStorage.setItem('tcm-reading', 'dim')
    }
    syncReadingIcon()
  })
</script>
