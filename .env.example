# Copy to .env and fill in. Never commit the real values.
SITE_PASSWORD=jeremy850916
# Secret used to sign the auth cookie (any long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# ── 資料庫（錯題本／作答紀錄；選用，未設則純本機 localStorage）────────────
# 在 Vercel → Storage / Marketplace 開一個 Upstash Redis（第一方 KV 已停售），
# 連到專案後這兩個變數會自動注入；本機開發才需手動填。支援 KV_* 或 UPSTASH_* 命名。
# 設定後：錯題本/作答紀錄會存進 DB（跨裝置共用）；可在 Upstash 後台設 key
# `tcm:password` 來改進站密碼（不必重新部署，會優先於 SITE_PASSWORD）。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
