# Copy to .env and fill in. Never commit the real values.
SITE_PASSWORD=jeremy850916
# Secret used to sign the auth cookie (any long random string)
AUTH_SECRET=change-me-to-a-long-random-string

# ── 錯題本/作答紀錄 的雲端同步（選用）─────────────────────────────────
# 不設也能用（純本機 localStorage）；設了才會跨裝置自動同步＋雲端備份。
# 在 Vercel → Storage 建一個 KV / Upstash Redis（不是 Postgres），
# 連到專案後這兩個變數通常會自動注入；本機開發才需手動填。
# 支援 KV_* 或 UPSTASH_* 兩種命名，任一組即可。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
